{
  "_comment": "Run `nugit agent -client claude-code -install` to write this as .mcp.json (other clients: `nugit agent -client cursor|codex|opencode`), then restart Claude Code to expose nugit's `context` tool. Requires `go install ./cmd/nugit` and ~/go/bin on PATH (or `-bin` / replace \"nugit\" with the absolute binary path).",
  "mcpServers": {
    "nugit": {
      "command": "nugit",
      "args": ["mcp", "-C", "."]
    }
  }
}
